# Inflect - Call Quality & Conversation Intelligence Platform
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit real API keys or DB passwords to .env.example!

# Primary AI Engine (API Key from https://aistudio.google.com/)
# GEMINI_API_KEY=your_gemini_api_key_here

# Fallback AI Engine (Optional - Free API Key from https://console.groq.com/)
# GROQ_API_KEY=your_groq_api_key_here

# Optional: Deepgram API Key (https://console.deepgram.com/)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database URL (Neon PostgreSQL or leave unset for local SQLite)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Authentication & Security
# JWT_SECRET_KEY=replace_with_32_char_random_secret
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# COOKIE_SECURE=false

# Multi-Tenancy, Quotas, Worker & Cache Tuning
# DEFAULT_ORG_DAILY_TOKEN_LIMIT=500000
# MAX_CONCURRENT_JOBS=4
# CACHE_TTL_DAYS=7
# MAX_CACHE_ENTRIES=5000

# Server Configuration
# PORT=8000
# HOST=0.0.0.0
